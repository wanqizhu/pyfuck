# +----------------------------------------------------------------+
# | pyfuck .gitignore                                              |
# | 只列本仓库真实会产生的东西；个人编辑器/OS 偏好建议放全局配置     |
# +----------------------------------------------------------------+

# --- Python 编译与缓存 ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- 打包与分发产物 ---
build/
dist/
*.egg-info/
*.egg
.eggs/
wheelhouse/
*.whl

# --- 虚拟环境 ---
.venv/
venv/
env/
ENV/
.python-version

# --- 测试与工具缓存 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
pip_diag.txt

# --- 环境变量 / 密钥 ---
.env
.env.*
!.env.example

# --- 混淆产物（体积可达数 MB，且是一整行，不入库）---
out*.py
pyfuck_output.py
*.fuck.py

# --- 编辑器与 OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
